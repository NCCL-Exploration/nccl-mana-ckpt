CC = nvcc
NCCL_HOME ?= $(NCCL_DIR)
CFLAGS = -O3 -g -lnccl -I../../include
ifneq ($(NCCL_HOME),)
  CFLAGS += -I$(NCCL_HOME)/include -L$(NCCL_HOME)/lib -Xlinker -rpath=$(NCCL_HOME)/lib
else
  CFLAGS += -L/shared/EL9/explorer/nvidia-hpc-sdk/24.7/Linux_x86_64/24.7/REDIST/comm_libs/12.5/nccl/lib
endif

# MPI is needed only by the multi-process tests. Resolve it from mpicc on PATH
# when MPI_HOME is unset, so a per-user MPI install works without editing paths;
# targets that need it add $(MPI_FLAGS) rather than every target paying for it.
MPICC_PATH := $(shell command -v mpicc 2>/dev/null)
ifeq ($(origin MPI_HOME),undefined)
  ifneq ($(MPICC_PATH),)
    MPI_HOME := $(realpath $(dir $(realpath $(MPICC_PATH)))..)
  endif
endif
MPI_FLAGS = -lmpi
ifneq ($(MPI_HOME),)
  MPI_FLAGS += -I$(MPI_HOME)/include -L$(MPI_HOME)/lib -Xlinker -rpath=$(MPI_HOME)/lib
endif

DMTCP_ROOT ?= ../../dmtcp

DMTCP_LAUNCH  = $(DMTCP_ROOT)/bin/dmtcp_launch
DMTCP_CMD     = $(DMTCP_ROOT)/bin/dmtcp_command
DMTCP_RESTART = $(DMTCP_ROOT)/bin/dmtcp_restart

NCCL_PLUGIN = ../../bin/libncclplugin.so
CUDA_PLUGIN = $(DMTCP_ROOT)/plugin/cuda/libdmtcp_cuda.so

# dmtcp_launch requires ABSOLUTE plugin paths: it hands the list to LD_PRELOAD in
# the target process, and a relative path there is not resolved against this
# directory. Passing relative paths silently loads neither plugin, which shows up
# much later as a restart that cannot mmap the GPU regions.
#
# Order matters and is load-bearing. Forward events (PRESUSPEND) run in
# registration order, so the NCCL drain and comm teardown happen before the CUDA
# plugin snapshots the GPU; reverse events (RUNNING_AFTER) run in the opposite
# order, so CUDA restores the context before the NCCL plugin rebuilds
# communicators on it. Swapping these two entries breaks both directions.
PLUGIN = $(abspath $(NCCL_PLUGIN)):$(abspath $(CUDA_PLUGIN))

export NCCL_DEBUG=WARN

# Colors for output
GREEN = \033[0;32m
RED = \033[0;31m
NC = \033[0m

$(NCCL_PLUGIN): FORCE
	$(MAKE) -C ../.. plugin

FORCE:

kill:
	-$(DMTCP_CMD) --coord-port $(PORT) --quit --quiet 2>/dev/null || true
	-killall -9 $(DRIVER) 2>/dev/null || true
	-killall -9 $(P2P_DRIVER) 2>/dev/null || true
